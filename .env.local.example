# ─────────────────────────────────────────────────────────────────────
# Microsoft Entra (Azure AD) — required for sign-in to work.
#
# Setup:
#   1. Go to https://entra.microsoft.com → App registrations → New registration
#   2. Name: Sendora Mail Hub (or anything)
#   3. Supported account types: pick what fits (single-tenant or multi-tenant)
#   4. Redirect URI: select "Single-page application (SPA)" and enter:
#        http://localhost:3000/login
#      Add your production URL too when you deploy:
#        https://yourdomain.com/login
#   5. After registration, copy:
#        - Application (client) ID  →  NEXT_PUBLIC_MSAL_CLIENT_ID
#        - Directory (tenant) ID    →  NEXT_PUBLIC_MSAL_TENANT_ID
#      Use "common" as tenant ID to allow any Microsoft account
#      (personal + any organization).
#   6. Save this file as `.env.local` and restart `npm run dev`.
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_TENANT_ID=common

# ─────────────────────────────────────────────────────────────────────
# Sendora API (NestJS). /api/* requests not handled by Next.js are proxied here.
# ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
